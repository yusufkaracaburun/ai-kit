# direnv config — auto-loaded when entering the repo. Install: https://direnv.net
# Run `direnv allow` after dropping or editing this file.

# Load .env.local without committing it (.env.local should be in .gitignore).
dotenv_if_exists .env.local

# Common per-project tweaks — uncomment what applies:

# Pin Node via nvm / fnm
# use node

# Pin Python via uv / pyenv
# layout uv
# use python 3.12

# Pin PHP via local Herd / valet
# export PATH="/Users/$USER/.config/herd-lite/bin:$PATH"

# Add ./bin to PATH for project-local scripts
# PATH_add bin

# Project-scoped tokens (never commit; this file is git-tracked but values
# should come from .env.local).
# export DATABASE_URL=
# export REDIS_URL=
