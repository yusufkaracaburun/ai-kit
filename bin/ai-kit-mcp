#!/usr/bin/env bash
# Thin wrapper that resolves the ai-kit clone and execs the built MCP server.
# Lets MCP clients reference the server by a stable name instead of an
# absolute path:
#
#   { "mcpServers": { "ai-kit": { "command": "ai-kit-mcp" } } }
#
# Symlinked into ~/.local/bin/ai-kit-mcp by install-global.sh so it lands on
# most users' PATH without manual config. If that directory isn't on your
# PATH, either add it (XDG default) or call this script by its full path.
set -euo pipefail

SCRIPT_BIN="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
# shellcheck source=lib/ai-kit-root.sh
source "$SCRIPT_BIN/lib/ai-kit-root.sh"
AIKIT="$(resolve_ai_kit_root "$SCRIPT_BIN")"

SERVER="$AIKIT/mcp/dist/server.js"
if [ ! -f "$SERVER" ]; then
  echo "ai-kit-mcp: server bundle not built." >&2
  echo "  Run: (cd \"$AIKIT/mcp\" && npm install && npm run build)" >&2
  exit 2
fi

if ! command -v node >/dev/null 2>&1; then
  echo "ai-kit-mcp: 'node' not on PATH. Install Node.js (>=20) first." >&2
  exit 2
fi

exec node "$SERVER" "$@"
