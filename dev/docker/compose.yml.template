# Minimal Compose starter — customize for your project.
# Copied by: $AI_KIT_ROOT/bin/apply-docker.sh TARGET minimal
#
# Common next steps:
# - Add a Dockerfile or point `build` at your app
# - Match ports to your framework (8000 Laravel, 3000 React, etc.)
# - Add REDIS, mailhog, etc. if needed

services:
  app:
    build: .
    working_dir: /app
    volumes:
      - .:/app
    ports:
      - "${APP_PORT:-8000}:8000"
    depends_on:
      - db
    environment:
      DATABASE_URL: postgres://app:secret@db:5432/app

  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: secret
      POSTGRES_DB: app
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - db_data:/var/lib/postgresql/data

volumes:
  db_data:
