.examples/upstream/
.DS_Store

# Eval results are runtime output, not committed
tests/eval/results/*
!tests/eval/results/.gitkeep
workflow/evals/results/

# Local environment files
.env
.env.local

# IDE / OS scratch
.idea/
.vscode/settings.json
.obsidian/
*.swp
*~

# Per-machine agent config
.claude/settings.local.json

# Companion tools installed into this clone by their own installers
# (caveman skills, skill lockfile, graphify knowledge graph). ai-kit
# recommends these — see context/templates/companions/ — but does not
# vendor them, and their generated output is not committed.
.agents/
.codex/
.claude/skills/
skills-lock.json
graphify-out/

# Scratch clones and throwaway working files. Never committed — this repo is
# public, and scratch material is frequently not.
.tmp/
